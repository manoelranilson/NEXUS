# Copie para .env (nunca versionar o .env)
NODE_ENV=production
PORT=8080
# Atrás de proxy HTTPS (Nginx, Azure, etc.): informe 1 para confiar no IP repassado
TRUST_PROXY=1
# Cookie só por HTTPS (obrigatório em produção)
COOKIE_SECURE=1
# Encerramento da sessão por inatividade fora dos conteúdos (minutos)
SESSAO_INATIVIDADE_MIN=30
# Duração máxima de uma sessão (horas)
SESSAO_MAX_HORAS=12
# Senha do primeiro administrador (se vazio, uma senha temporária é gerada e mostrada no log)
NEXUS_ADMIN_SENHA=
NEXUS_DB=/dados/nexus.db
NEXUS_CONTEUDOS=/conteudos
